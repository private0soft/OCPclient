<?xml version="1.0" encoding="utf-8"?>
<resources>

    <dimen name="stdpadding">20dp</dimen>
    <dimen name="myoc_radius">18dp</dimen>
    <dimen name="myoc_radius_sm">14dp</dimen>
    <dimen name="myoc_btn_height">56dp</dimen>
    <dimen name="myoc_nav_height">64dp</dimen>
    <dimen name="myoc_orb">168dp</dimen>
    <dimen name="myoc_pref_pad">16dp</dimen>

    <!-- Day / light: Material.Light (not DarkActionBar) so titles/icons stay dark on light chrome -->
    <style name="Theme.MyOC" parent="@android:style/Theme.Material.Light">
        <item name="android:colorPrimary">@color/myoc_bg_elevated</item>
        <item name="android:colorPrimaryDark">@color/myoc_bg</item>
        <item name="android:colorAccent">@color/myoc_accent</item>
        <item name="android:windowBackground">@color/myoc_bg</item>
        <item name="android:colorBackground">@color/myoc_bg</item>
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorPrimary">@color/myoc_text</item>
        <item name="android:textColorSecondary">@color/myoc_text_muted</item>
        <item name="android:textColorTertiary">@color/myoc_text_muted</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
        <item name="android:textColorPrimaryInverse">@color/myoc_bg</item>
        <item name="android:textColorSecondaryInverse">@color/myoc_text_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/myoc_text</item>
        <item name="android:editTextColor">@color/myoc_text</item>
        <item name="android:textColorLink">@color/myoc_accent</item>
        <item name="android:colorControlNormal">@color/myoc_text_muted</item>
        <item name="android:colorControlActivated">@color/myoc_accent</item>
        <item name="android:colorControlHighlight">@color/myoc_accent_soft</item>
        <item name="android:colorButtonNormal">@color/myoc_surface_high</item>
        <item name="android:navigationBarColor">@color/myoc_bg_elevated</item>
        <item name="android:statusBarColor">@color/myoc_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:actionBarStyle">@style/MyOC.ActionBar</item>
        <item name="android:actionOverflowButtonStyle">@style/MyOC.Overflow</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_nav_back</item>
        <item name="android:actionMenuTextColor">@color/myoc_text</item>
        <item name="android:buttonStyle">@style/MyOC.Button</item>
        <item name="android:alertDialogTheme">@style/MyOC.Dialog</item>
        <item name="android:listDivider">@color/myoc_divider</item>
        <item name="android:listPreferredItemHeight">56dp</item>
        <item name="android:listPreferredItemHeightLarge">72dp</item>
        <item name="android:listPreferredItemPaddingLeft">16dp</item>
        <item name="android:listPreferredItemPaddingRight">16dp</item>
        <item name="android:selectableItemBackground">@drawable/bg_selectable</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/bg_selectable_round</item>
        <item name="android:editTextBackground">@drawable/bg_edit_text</item>
        <item name="android:checkboxStyle">@style/MyOC.CheckBox</item>
        <item name="android:spinnerStyle">@style/MyOC.Spinner</item>
        <item name="android:popupMenuStyle">@style/MyOC.PopupMenu</item>
        <item name="android:textViewStyle">@style/MyOC.TextView</item>
        <item name="android:itemTextAppearance">@style/MyOC.MenuItem</item>
        <item name="android:textAppearanceLargePopupMenu">@style/MyOC.MenuItem</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/MyOC.MenuItem</item>
        <item name="android:dropDownItemStyle">@style/MyOC.DropDownItem</item>
        <item name="android:listSeparatorTextViewStyle">@style/MyOC.ListSeparator</item>
        <item name="android:textAppearance">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceLarge">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceMedium">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceSmall">@style/MyOC.TextAppearance.Secondary</item>
        <item name="android:textAppearanceListItem">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceListItemSecondary">@style/MyOC.TextAppearance.Secondary</item>
        <item name="android:textAppearanceListItemSmall">@style/MyOC.TextAppearance</item>
        <item name="android:preferenceStyle">@style/MyOC.Preference</item>
        <item name="android:preferenceCategoryStyle">@style/MyOC.PreferenceCategory</item>
        <item name="android:checkBoxPreferenceStyle">@style/MyOC.CheckBoxPreference</item>
        <item name="android:dialogPreferenceStyle">@style/MyOC.DialogPreference</item>
        <item name="android:editTextPreferenceStyle">@style/MyOC.EditTextPreference</item>
    </style>

    <style name="MyOC" />

    <style name="MyOC.ActionBar" parent="@android:style/Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/myoc_bg</item>
        <item name="android:titleTextStyle">@style/MyOC.ActionBar.Title</item>
        <item name="android:subtitleTextStyle">@style/MyOC.ActionBar.Title</item>
        <item name="android:elevation">0dp</item>
        <item name="android:height">56dp</item>
        <item name="android:displayOptions">showTitle|homeAsUp</item>
    </style>

    <style name="MyOC.ActionBar.Title" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MyOC.Overflow" parent="@android:style/Widget.Material.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_menu_overflow</item>
        <item name="android:tint">@color/myoc_text</item>
        <item name="android:background">@drawable/bg_overflow_btn</item>
        <item name="android:padding">6dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:contentDescription">@string/more_options</item>
    </style>

    <style name="MyOC.TextView" parent="@android:style/Widget.Material.Light.TextView">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
    </style>

    <style name="MyOC.MenuItem" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MyOC.DropDownItem" parent="@android:style/Widget.Material.Light.DropDownItem.Spinner">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="MyOC.ListSeparator" parent="@android:style/Widget.Material.Light.TextView">
        <item name="android:textColor">@color/myoc_accent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="MyOC.TextAppearance" parent="@android:style/TextAppearance.Material">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MyOC.TextAppearance.Secondary" parent="@android:style/TextAppearance.Material.Small">
        <item name="android:textColor">@color/myoc_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="MyOC.Preference">
        <item name="android:layout">@layout/myoc_preference</item>
    </style>

    <style name="MyOC.PreferenceCategory">
        <item name="android:layout">@layout/myoc_preference_category</item>
    </style>

    <style name="MyOC.CheckBoxPreference">
        <item name="android:layout">@layout/myoc_preference</item>
        <item name="android:widgetLayout">@layout/myoc_preference_checkbox</item>
    </style>

    <style name="MyOC.DialogPreference">
        <item name="android:layout">@layout/myoc_preference</item>
        <item name="android:positiveButtonText">@android:string/ok</item>
        <item name="android:negativeButtonText">@android:string/cancel</item>
    </style>

    <style name="MyOC.EditTextPreference">
        <item name="android:layout">@layout/myoc_preference</item>
        <item name="android:positiveButtonText">@android:string/ok</item>
        <item name="android:negativeButtonText">@android:string/cancel</item>
    </style>

    <style name="MyOC.CheckBox" parent="@android:style/Widget.Material.Light.CompoundButton.CheckBox">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:buttonTint">@color/myoc_checkbox_tint</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="MyOC.Spinner" parent="@android:style/Widget.Material.Light.Spinner">
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="MyOC.PopupMenu" parent="@android:style/Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="MyOC.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/myoc_btn_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">@dimen/myoc_btn_height</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="MyOC.Button.Danger" parent="@style/MyOC.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/myoc_text</item>
    </style>

    <style name="MyOC.Button.Ghost" parent="@style/MyOC.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/myoc_text</item>
    </style>

    <style name="MyOC.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/myoc_accent</item>
        <item name="android:colorPrimary">@color/myoc_accent</item>
        <item name="android:background">@color/myoc_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorPrimary">@color/myoc_text</item>
        <item name="android:textColorSecondary">@color/myoc_text_muted</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
        <item name="android:editTextColor">@color/myoc_text</item>
        <item name="android:colorControlActivated">@color/myoc_accent</item>
        <item name="android:buttonBarButtonStyle">@style/MyOC.Dialog.Button</item>
    </style>

    <style name="MyOC.Dialog.Button" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/myoc_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="MyOC.BottomSheet" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="MyOC.Toggle" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="MyOC.AuthPrompt" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/myoc_accent</item>
        <item name="android:background">@color/myoc_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorPrimary">@color/myoc_text</item>
        <item name="android:textColorSecondary">@color/myoc_text_muted</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
        <item name="android:editTextColor">@color/myoc_text</item>
        <item name="android:colorControlActivated">@color/myoc_accent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:buttonBarButtonStyle">@style/MyOC.Dialog.Button</item>
    </style>

    <style name="MyOC.Brand">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="MyOC.Headline">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="MyOC.Body">
        <item name="android:textColor">@color/myoc_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="MyOC.Meta">
        <item name="android:textColor">@color/myoc_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="MyOC.NavLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

</resources>
