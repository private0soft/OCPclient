<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="@dimen/stdpadding">

    <EditText
        android:id="@+id/app_list_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_surface"
        android:gravity="center_vertical"
        android:hint="@string/per_app_search"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text|textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/myoc_text"
        android:textColorHint="@color/myoc_text_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:padding="14dp">

        <CheckBox
            android:id="@+id/app_list_system"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/myoc_accent"
            android:text="@string/per_app_show_system"
            android:textColor="@color/myoc_text" />

        <Button
            android:id="@+id/app_list_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/save" />
    </LinearLayout>

    <ListView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:listSelector="@android:color/transparent" />
</LinearLayout>
