<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Night / dark: Material (dark) widgets match the night palette -->
    <style name="Theme.MyOC" parent="@android:style/Theme.Material">
        <item name="android:colorPrimary">@color/myoc_bg_elevated</item>
        <item name="android:colorPrimaryDark">@color/myoc_bg</item>
        <item name="android:colorAccent">@color/myoc_accent</item>
        <item name="android:windowBackground">@color/myoc_bg</item>
        <item name="android:colorBackground">@color/myoc_bg</item>
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorPrimary">@color/myoc_text</item>
        <item name="android:textColorSecondary">@color/myoc_text_muted</item>
        <item name="android:textColorTertiary">@color/myoc_text_muted</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
        <item name="android:textColorPrimaryInverse">@color/myoc_bg</item>
        <item name="android:textColorSecondaryInverse">@color/myoc_text_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/myoc_text</item>
        <item name="android:editTextColor">@color/myoc_text</item>
        <item name="android:textColorLink">@color/myoc_accent</item>
        <item name="android:colorControlNormal">@color/myoc_text_muted</item>
        <item name="android:colorControlActivated">@color/myoc_accent</item>
        <item name="android:colorControlHighlight">@color/myoc_accent_soft</item>
        <item name="android:colorButtonNormal">@color/myoc_surface_high</item>
        <item name="android:navigationBarColor">@color/myoc_bg_elevated</item>
        <item name="android:statusBarColor">@color/myoc_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:actionBarStyle">@style/MyOC.ActionBar</item>
        <item name="android:actionOverflowButtonStyle">@style/MyOC.Overflow</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_nav_back</item>
        <item name="android:actionMenuTextColor">@color/myoc_text</item>
        <item name="android:buttonStyle">@style/MyOC.Button</item>
        <item name="android:alertDialogTheme">@style/MyOC.Dialog</item>
        <item name="android:listDivider">@color/myoc_divider</item>
        <item name="android:listPreferredItemHeight">56dp</item>
        <item name="android:listPreferredItemHeightLarge">72dp</item>
        <item name="android:listPreferredItemPaddingLeft">16dp</item>
        <item name="android:listPreferredItemPaddingRight">16dp</item>
        <item name="android:selectableItemBackground">@drawable/bg_selectable</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/bg_selectable_round</item>
        <item name="android:editTextBackground">@drawable/bg_edit_text</item>
        <item name="android:checkboxStyle">@style/MyOC.CheckBox</item>
        <item name="android:spinnerStyle">@style/MyOC.Spinner</item>
        <item name="android:popupMenuStyle">@style/MyOC.PopupMenu</item>
        <item name="android:textViewStyle">@style/MyOC.TextView</item>
        <item name="android:itemTextAppearance">@style/MyOC.MenuItem</item>
        <item name="android:textAppearanceLargePopupMenu">@style/MyOC.MenuItem</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/MyOC.MenuItem</item>
        <item name="android:dropDownItemStyle">@style/MyOC.DropDownItem</item>
        <item name="android:listSeparatorTextViewStyle">@style/MyOC.ListSeparator</item>
        <item name="android:textAppearance">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceLarge">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceMedium">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceSmall">@style/MyOC.TextAppearance.Secondary</item>
        <item name="android:textAppearanceListItem">@style/MyOC.TextAppearance</item>
        <item name="android:textAppearanceListItemSecondary">@style/MyOC.TextAppearance.Secondary</item>
        <item name="android:textAppearanceListItemSmall">@style/MyOC.TextAppearance</item>
        <item name="android:preferenceStyle">@style/MyOC.Preference</item>
        <item name="android:preferenceCategoryStyle">@style/MyOC.PreferenceCategory</item>
        <item name="android:checkBoxPreferenceStyle">@style/MyOC.CheckBoxPreference</item>
        <item name="android:dialogPreferenceStyle">@style/MyOC.DialogPreference</item>
        <item name="android:editTextPreferenceStyle">@style/MyOC.EditTextPreference</item>
    </style>

    <style name="MyOC.ActionBar" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/myoc_bg</item>
        <item name="android:titleTextStyle">@style/MyOC.ActionBar.Title</item>
        <item name="android:subtitleTextStyle">@style/MyOC.ActionBar.Title</item>
        <item name="android:elevation">0dp</item>
        <item name="android:height">56dp</item>
    </style>

    <style name="MyOC.TextView" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
    </style>

    <style name="MyOC.MenuItem" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MyOC.DropDownItem" parent="@android:style/Widget.Material.DropDownItem.Spinner">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="MyOC.ListSeparator" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/myoc_accent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="MyOC.CheckBox" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:buttonTint">@color/myoc_checkbox_tint</item>
        <item name="android:paddingStart">8dp</item>
    </style>

    <style name="MyOC.Spinner" parent="@android:style/Widget.Material.Spinner">
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="MyOC.PopupMenu" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="MyOC.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/myoc_accent</item>
        <item name="android:colorPrimary">@color/myoc_accent</item>
        <item name="android:background">@color/myoc_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorPrimary">@color/myoc_text</item>
        <item name="android:textColorSecondary">@color/myoc_text_muted</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
        <item name="android:editTextColor">@color/myoc_text</item>
        <item name="android:colorControlActivated">@color/myoc_accent</item>
        <item name="android:buttonBarButtonStyle">@style/MyOC.Dialog.Button</item>
    </style>

    <style name="MyOC.BottomSheet" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="MyOC.AuthPrompt" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/myoc_accent</item>
        <item name="android:background">@color/myoc_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColor">@color/myoc_text</item>
        <item name="android:textColorPrimary">@color/myoc_text</item>
        <item name="android:textColorSecondary">@color/myoc_text_muted</item>
        <item name="android:textColorHint">@color/myoc_text_muted</item>
        <item name="android:editTextColor">@color/myoc_text</item>
        <item name="android:colorControlActivated">@color/myoc_accent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:buttonBarButtonStyle">@style/MyOC.Dialog.Button</item>
    </style>

</resources>
