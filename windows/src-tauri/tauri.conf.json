{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenConnect +P",
  "mainBinaryName": "OpenConnect-P",
  "version": "1.0.3",
  "identifier": "com.openconnectplusp.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenConnect +P",
        "width": 360,
        "height": 600,
        "minWidth": 320,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "../vendor/openconnect/bin/*": "./",
      "../vendor/scripts/*": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
